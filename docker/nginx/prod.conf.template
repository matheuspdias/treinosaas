# Produção. ${API_HOST} e ${PWA_HOST} vêm do docker-compose.prod.yml; um certificado vale para os três nomes
# (o www só redireciona para o domínio principal).

server {
    listen 80;
    server_name ${API_HOST} www.${API_HOST} ${PWA_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${API_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://${API_HOST}$request_uri;
}

# Landing, painel e API.
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/html/public;
    index index.php;

    client_max_body_size 10M;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location /exercises/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /build/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~ ^/(fonts|landing)/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
        fastcgi_connect_timeout 5s;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 8 32k;
        fastcgi_busy_buffers_size 64k;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# App do aluno (PWA): arquivos estáticos do build, cada academia em /{slug}/.
server {
    listen 443 ssl;
    http2 on;
    server_name ${PWA_HOST};

    ssl_certificate     /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /srv/pwa;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /exercises/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html e sw.js sempre revalidados: é assim que o aluno recebe a versão nova.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
